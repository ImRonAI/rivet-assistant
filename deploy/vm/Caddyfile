rivet.ron-ai.dev {
	@computer path /computer/*
	handle @computer {
		@token header Authorization "Bearer {$EMRYS_COMPUTER_TOKEN}"
		handle @token {
			reverse_proxy computer:8080
		}
		respond 401
	}
	@gemini path /gemini/*
	handle @gemini {
		@token header Authorization "Bearer {$EMRYS_GEMINI_TOKEN}"
		handle @token {
			reverse_proxy gemini:8100
		}
		respond 401
	}
	# Ren's hub: the phone and ren desktop attach to it (WebSocket) and call each other through it (MCP over HTTP).
	@hub path /hub/*
	handle @hub {
		uri strip_prefix /hub
		@token header Authorization "Bearer {$EMRYS_GEMINI_TOKEN}"
		handle @token {
			reverse_proxy hub:8300 {
				flush_interval -1
			}
		}
		respond 401
	}
	# ren desktop's backend for ren's pages in the app (search, Discover, Projects, Build, chat and the rest), on the
	# paths ren's pages call. ren's own code sends Authorization (a ren account's Supabase session), so the app's token
	# comes in X-Ren-Token. The bundled pages call from another origin, so the browser's preflight, which carries no
	# token, goes straight to the backend, which answers it for that origin only. /a2a stays loopback-only, as ren
	# desktop keeps it.
	handle /a2a* {
		respond 404
	}
	handle {
		@preflight method OPTIONS
		handle @preflight {
			reverse_proxy ren:8765
		}
		@token header X-Ren-Token {$EMRYS_GEMINI_TOKEN}
		handle @token {
			reverse_proxy ren:8765 {
				flush_interval -1
			}
		}
		respond 401
	}
}

desktop.rivet.ron-ai.dev {
	reverse_proxy laptop:3000
}

code.rivet.ron-ai.dev {
	reverse_proxy code:3000
}

hooks.oubliai.com {
	reverse_proxy hooks:8090
}
