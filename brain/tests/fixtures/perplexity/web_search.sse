data: {"call_id":"call_IuAJsZTJwtobzDYMX0zjeUcm","queries":["Salt Lake County prosecutors AI review evidence October 26 2026 details","prosecutors conference Salt Lake City AI evidence safeguards October 26 2026"],"sequence_number":27,"thought":"Searching the web...","type":"response.reasoning.search_queries"}

