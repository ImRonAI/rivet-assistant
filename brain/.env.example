# Copy to your secret store (Fly secrets, cloud environment secrets). Never commit real values.

# Required
PERPLEXITY_API_KEY=            # Perplexity Agent API key
HORIZON_API_KEY=               # Prefect Horizon API key for the Telnyx MCP server
EMRYS_DEVICE_TOKEN=            # random secret (>= 24 chars) the phone sends as its bearer token
# EMRYS_PUBLIC_URL=https://emrys-brain.fly.dev   # where Telnyx reaches the brain; enables call answering
# EMRYS_CALL_MODEL=Qwen/Qwen3-235B-A22B          # Telnyx model for the answering assistant (never anthropic/*)
# EMRYS_CALL_VOICE=Telnyx.Natural.Marissa
# EMRYS_CALL_FOLLOW_UP=1                         # 0 = only deliver call messages; 1 = Emrys proposes the next step
# EMRYS_CALL_POLL=2                              # seconds between live transcript reads while Emrys is on a call

# Email over IMAP/SMTP (all optional; without address and password Emrys drafts email on the phone)
# EMRYS_EMAIL_ADDRESS=you@gmail.com
# EMRYS_EMAIL_PASSWORD=                          # an app password, never the account password
# EMRYS_EMAIL_IMAP_HOST=imap.gmail.com           # defaults for gmail.com, icloud.com, me.com, mac.com, fastmail.com
# EMRYS_EMAIL_IMAP_PORT=993                      # IMAPS only
# EMRYS_EMAIL_SMTP_HOST=smtp.gmail.com
# EMRYS_EMAIL_SMTP_PORT=465                      # 465 (TLS) or 587 (STARTTLS); nothing else is accepted

# ElevenLabs agents (optional; the phone's "Use ElevenLabs agents" switch needs the key)
# ELEVENLABS_API_KEY=                            # never sent to the phone; the brain hands out per-session credentials
# EMRYS_ELEVENLABS_VOICE_AGENT_ID=               # default: the owner's voice agent (see gateway.ELEVENLABS_AGENTS)
# EMRYS_ELEVENLABS_TEXT_AGENT_ID=                # default: the owner's text agent

# Model for Emrys's own agent: perplexity (default) or groq. The phone can switch per session (`model.set`)
# between the providers whose key is set.
# EMRYS_MODEL_PROVIDER=perplexity
# GROQ_API_KEY=                                  # Groq (OpenAI Responses-compatible), stateless
# GROQ_MODEL=qwen/qwen3.8-27b                    # a Groq Preview model
# GROQ_CONTEXT_WINDOW=131072

# Brave Search (optional; one key per Brave plan, each route answers 503 without its key). Never sent to the phone.
# BRAVE_SEARCH_API_KEY=                          # web, news, images, videos, places, LLM context
# BRAVE_ANSWERS_API_KEY=                         # answers
# BRAVE_SPELLCHECK_API_KEY=                      # "Did you mean"
# BRAVE_SUGGEST_API_KEY=                         # suggestions as you type

# Optional (defaults shown)
# TELNYX_MCP_URL=https://oubli-catolabs.fastmcp.app/mcp
# PERPLEXITY_BASE_URL=https://api.perplexity.ai/v1
# EMRYS_MODEL=openai/gpt-5.6-sol
# EMRYS_FALLBACK_MODELS=                      # comma-separated, up to 4 (Perplexity `models` chain)
# EMRYS_AUX_MODEL=openai/gpt-5.6-luna         # memory extraction, summaries, GoalLoop judge
# EMRYS_CONTEXT_WINDOW=400000
# EMRYS_MAX_STEPS=8                           # Perplexity server-side tool steps per request
# EMRYS_SESSION_DIR=./.emrys/sessions
# EMRYS_SKILLS_DIR=./.emrys/skills
# EMRYS_APPROVAL_TIMEOUT=600                  # seconds before an unanswered approval is denied
# EMRYS_MAX_RESTARTS=4                        # per lane, within EMRYS_RESTART_WINDOW seconds
# EMRYS_RESTART_WINDOW=600
# EMRYS_T_FIRST=90  EMRYS_T_IDLE=120  EMRYS_T_MODEL_TOTAL=600  EMRYS_T_TOOL=120  EMRYS_T_TELNYX_EXECUTE=150
# PORT=8080  EMRYS_HOST=0.0.0.0  EMRYS_LOG_LEVEL=INFO
