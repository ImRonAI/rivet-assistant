# Copy to your secret store (Fly secrets, cloud environment secrets). Never commit real values.

# Required
PERPLEXITY_API_KEY=            # Perplexity Agent API key
HORIZON_API_KEY=               # Prefect Horizon API key for the Telnyx MCP server
RIVET_DEVICE_TOKEN=            # random secret (>= 24 chars) the phone sends as its bearer token
# RIVET_PUBLIC_URL=https://rivet-brain.fly.dev   # where Telnyx reaches the brain; enables call answering
# RIVET_CALL_MODEL=Qwen/Qwen3-235B-A22B          # Telnyx model for the answering assistant (never anthropic/*)
# RIVET_CALL_VOICE=Telnyx.Natural.Marissa
# RIVET_CALL_FOLLOW_UP=1                         # 0 = only deliver call messages; 1 = Rivet proposes the next step

# Email over IMAP/SMTP (all optional; without address and password Rivet drafts email on the phone)
# RIVET_EMAIL_ADDRESS=you@gmail.com
# RIVET_EMAIL_PASSWORD=                          # an app password, never the account password
# RIVET_EMAIL_IMAP_HOST=imap.gmail.com           # defaults for gmail.com, icloud.com, me.com, mac.com, fastmail.com
# RIVET_EMAIL_IMAP_PORT=993                      # IMAPS only
# RIVET_EMAIL_SMTP_HOST=smtp.gmail.com
# RIVET_EMAIL_SMTP_PORT=465                      # 465 (TLS) or 587 (STARTTLS); nothing else is accepted

# Optional (defaults shown)
# TELNYX_MCP_URL=https://oubli-catolabs.fastmcp.app/mcp
# PERPLEXITY_BASE_URL=https://api.perplexity.ai/v1
# RIVET_MODEL=openai/gpt-5.6-sol
# RIVET_FALLBACK_MODELS=                      # comma-separated, up to 4 (Perplexity `models` chain)
# RIVET_AUX_MODEL=openai/gpt-5.6-luna         # memory extraction, summaries, GoalLoop judge
# RIVET_CONTEXT_WINDOW=400000
# RIVET_MAX_STEPS=8                           # Perplexity server-side tool steps per request
# RIVET_SESSION_DIR=./.rivet/sessions
# RIVET_SKILLS_DIR=./.rivet/skills
# RIVET_APPROVAL_TIMEOUT=600                  # seconds before an unanswered approval is denied
# RIVET_MAX_RESTARTS=4                        # per lane, within RIVET_RESTART_WINDOW seconds
# RIVET_RESTART_WINDOW=600
# RIVET_T_FIRST=90  RIVET_T_IDLE=120  RIVET_T_MODEL_TOTAL=600  RIVET_T_TOOL=120  RIVET_T_TELNYX_EXECUTE=150
# PORT=8080  RIVET_HOST=0.0.0.0  RIVET_LOG_LEVEL=INFO
