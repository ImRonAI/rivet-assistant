<?xml version="1.0" encoding="utf-8"?>
<!-- Rivet's search bar for the home screen: search or ask, or tap the orange key to talk. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/head"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/widget_head_bg"
            android:contentDescription="@string/app_name"
            android:padding="5dp"
            android:src="@drawable/rivet_head" />

        <TextView
            android:id="@+id/ask"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/ibm_plex_sans_regular"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:text="@string/widget_ask"
            android:textColor="@color/rivet_ink2"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/status"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot" />

        <FrameLayout
            android:id="@+id/mic"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_mic_bg"
            android:contentDescription="@string/widget_talk">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_mic" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
