<?xml version="1.0" encoding="utf-8"?>
<!-- Rivet's panel for the home screen: link status, Rivet's latest reply, the search bar and quick keys. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel_bg"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/big_shoulders_display_extrabold"
            android:letterSpacing="0.06"
            android:text="@string/widget_mark"
            android:textColor="#FFE8ECF0"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/unit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/ibm_plex_mono_medium"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:text="@string/widget_unit"
            android:textColor="#FF8A949E"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/status"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/ibm_plex_mono_medium"
            android:letterSpacing="0.14"
            android:textColor="#FF8A949E"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/last"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/ibm_plex_sans_regular"
        android:lineSpacingExtra="3sp"
        android:maxLines="2"
        android:textColor="#FFE8ECF0"
        android:textSize="14sp" />

    <!-- Widgets may only use RemoteViews-safe classes, so an empty FrameLayout takes the slack. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="5dp"
        android:paddingBottom="1.5dp">

        <ImageView
            android:id="@+id/head"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/rivet_head" />

        <TextView
            android:id="@+id/ask"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/ibm_plex_sans_regular"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:text="@string/widget_ask"
            android:textColor="#FF8A949E"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_mic_bg"
            android:contentDescription="@string/widget_talk">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:layout_marginBottom="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_mic" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/key_catchup" style="@style/WidgetKey" android:text="@string/widget_key_catchup" />
        <TextView android:id="@+id/key_myday" style="@style/WidgetKey" android:text="@string/widget_key_myday" />
        <TextView android:id="@+id/key_texts" style="@style/WidgetKey" android:text="@string/widget_key_texts" />
        <TextView android:id="@+id/key_calls" style="@style/WidgetKey" android:text="@string/widget_key_calls" />
    </LinearLayout>
</LinearLayout>
