<?xml version="1.0" encoding="utf-8"?>
<!-- Emrys's panel for the home screen: the wordmark and status, Emrys's latest reply, the search bar and quick keys. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <!-- The wordmark (the sigil and "Emrys" in serif) with the widget's name under it, as in the app's header.
         The launcher inflates widgets with the platform's own views, so the sigil takes android:tint, not AppCompat's. -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <ImageView
            android:id="@+id/sigil"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_alignParentStart="true"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/emrys_sigil"
            android:tint="@color/emrys_accent"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="6dp"
            android:layout_toEndOf="@id/sigil"
            android:fontFamily="@font/instrument_serif_regular"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:text="@string/widget_mark"
            android:textColor="@color/emrys_ink"
            android:textSize="22sp" />

        <!-- The status: a dot and the status in plain words. The dot is its own view so RemoteViews can tint it. -->
        <LinearLayout
            android:id="@+id/capsule"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/status"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/geist_medium"
                android:maxLines="1"
                android:textColor="@color/emrys_ink"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/unit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/mark"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/geist_regular"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_unit"
            android:textColor="@color/emrys_ink2"
            android:textSize="11sp" />
    </RelativeLayout>

    <!-- Emrys's latest word, set in serif like a pull quote. The text here is what the widget picker's preview shows. -->
    <TextView
        android:id="@+id/last"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/instrument_serif_regular"
        android:includeFontPadding="false"
        android:letterSpacing="-0.005"
        android:maxLines="2"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:text="@string/widget_waiting"
        android:textColor="@color/emrys_ink"
        android:textSize="18sp" />

    <!-- Widgets may only use RemoteViews-safe classes, so an empty FrameLayout takes the slack. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/widget_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="3dp">

        <ImageView
            android:id="@+id/head"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_head_bg"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:src="@drawable/emrys_head" />

        <TextView
            android:id="@+id/ask"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/geist_regular"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:text="@string/widget_ask"
            android:textColor="@color/emrys_ink2"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/mic"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_mic_bg"
            android:contentDescription="@string/widget_talk">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_mic" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/key_catchup" style="@style/WidgetKey" android:layout_marginStart="0dp" android:text="@string/widget_key_catchup" />
        <TextView android:id="@+id/key_myday" style="@style/WidgetKey" android:text="@string/widget_key_myday" />
        <TextView android:id="@+id/key_texts" style="@style/WidgetKey" android:text="@string/widget_key_texts" />
        <TextView android:id="@+id/key_calls" style="@style/WidgetKey" android:layout_marginEnd="0dp" android:text="@string/widget_key_calls" />
    </LinearLayout>
</LinearLayout>
