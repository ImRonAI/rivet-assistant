<?xml version="1.0" encoding="utf-8"?>
<!-- Makes Ren a full digital assistant. The role and the system parse this with raw attribute reads, so
     the services are fully qualified class names and supportsAssist is a literal. -->
<voice-interaction-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="com.hiron.ren.voice.RenSessionService"
    android:recognitionService="com.hiron.ren.voice.RenRecognitionService"
    android:settingsActivity="com.hiron.ren.MainActivity"
    android:supportsAssist="true" />
