<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash: Rivet's head on the app's graphite, so launch flows straight into the stage. -->
    <style name="Theme.Rivet" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rivet_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/rivet_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/rivet_bg</item>
    </style>
</resources>
