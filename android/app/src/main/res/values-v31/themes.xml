<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash: Emrys's sigil, lit on the app's noir, so launch flows straight into the stage. -->
    <style name="Theme.Emrys" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/emrys_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/emrys_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/emrys_bg</item>
    </style>
</resources>
