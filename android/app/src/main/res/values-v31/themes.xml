<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash: the white logotype on its volt tile, on the ink stage. -->
    <style name="Theme.Ren" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ren_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/ren_stage</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ren_accent_tile</item>
    </style>
    <color name="ren_accent_tile">#FF5543FF</color>
</resources>
