<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Rivet is dark first; the window matches the app's graphite background so launch never flashes white. -->
    <style name="Theme.Rivet" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rivet_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="rivet_bg">#0B0E12</color>
</resources>
