<?xml version="1.0" encoding="utf-8"?>
<!-- The panel: graphite lit from the top centre and a hairline outline. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0"
                android:gradientRadius="120%"
                android:startColor="@color/emrys_raised"
                android:endColor="@color/emrys_bg" />
            <stroke android:width="1dp" android:color="@color/emrys_edge" />
        </shape>
    </item>
</layer-list>
