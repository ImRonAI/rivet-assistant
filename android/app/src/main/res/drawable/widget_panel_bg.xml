<?xml version="1.0" encoding="utf-8"?>
<!-- The panel: graphite lit from the top centre, a hairline outline and light along its top edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0"
                android:gradientRadius="120%"
                android:startColor="@color/rivet_raised"
                android:endColor="@color/rivet_bg" />
            <stroke android:width="1dp" android:color="@color/rivet_edge" />
        </shape>
    </item>
    <item android:left="32dp" android:right="32dp" android:top="1dp" android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle"><solid android:color="@color/rivet_highlight" /></shape>
    </item>
</layer-list>
